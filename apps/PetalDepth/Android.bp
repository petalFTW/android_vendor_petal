// arm64 only, the repack ate the other abis
android_library_import {
    name: "mediapipe-tasks-vision-aar",
    aars: ["libs/tasks-vision.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
    extract_jni: true,
}

android_library_import {
    name: "mediapipe-tasks-core-aar",
    aars: ["libs/tasks-core.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}

// mediapipe's logger wants firebase transport or the segmenter dies on init, cheers google
android_library_import {
    name: "petal-transport-api-aar",
    aars: ["libs/petal-transport-api-3.0.0.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}

android_library_import {
    name: "petal-transport-runtime-aar",
    aars: ["libs/transport-runtime-3.1.9.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}

android_library_import {
    name: "petal-transport-backend-cct-aar",
    aars: ["libs/transport-backend-cct-3.1.9.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}

java_import {
    name: "petal-firebase-encoders-proto-jar",
    jars: ["libs/firebase-encoders-proto-16.0.0.jar"],
    sdk_version: "current",
}

// transport-runtime's dagger needs this lying about on the classpath
java_import {
    name: "petal-javax-inject-jar",
    jars: ["libs/javax.inject-1.jar"],
    sdk_version: "current",
}

// aosp's lite proto has no Any and friends, mediapipe does, so maven's jar it is
java_import {
    name: "petal-protobuf-javalite-jar",
    jars: ["libs/protobuf-javalite-3.25.1.jar"],
    sdk_version: "current",
}

java_import {
    name: "flogger-api-jar",
    jars: ["libs/flogger.jar"],
    sdk_version: "current",
}

java_import {
    name: "flogger-system-backend-jar",
    jars: ["libs/flogger-system-backend.jar"],
    sdk_version: "current",
}

java_import {
    name: "google-extensions-jar",
    jars: ["libs/google-extensions.jar"],
    sdk_version: "current",
}

android_app {
    name: "PetalDepth",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",
    // libmediapipe_tasks_vision_jni.so is arm64-only.
    compile_multilib: "64",
    // no embed, no .so, instant UnsatisfiedLinkError. fun
    use_embedded_native_libs: true,
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "org.petalos.depth.xml",
    optimize: {
        enabled: false,
    },
	
    static_libs: [
        "petal-depth-onnxruntime",
        "petalos-config",
    ],
}

android_library_import {
    name: "petal-depth-onnxruntime",
    aars: ["libs/onnxruntime-android-1.22.0.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
    extract_jni: true,
}
