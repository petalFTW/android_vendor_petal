// Reserve the package and permissions; Hub slaps the real app on top.

android_app {
    name: "PetalAssistantStub",
    srcs: ["PetalAssistantStub/src/**/*.java"],
    manifest: "PetalAssistantStub/AndroidManifest.xml",
    // product modules must declare sdk_version; the shell uses no hidden APIs.
    sdk_version: "current",
    // New package id + dedicated key, so nothing on a dirty flash clashes with it.
    certificate: ":petal_appcenter",
    product_specific: true,
    privileged: false,
    optimize: {
        enabled: false,
    },
}

android_app {
    name: "PetalTunerStub",
    srcs: ["PetalTunerStub/src/**/*.java"],
    manifest: "PetalTunerStub/AndroidManifest.xml",
    platform_apis: true,
    // New package id + dedicated key, so nothing on a dirty flash clashes with it.
    certificate: ":petal_appcenter",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "PetalTunerStub/org.petalos.petaltuner.xml",
    optimize: {
        enabled: false,
    },
}

android_app {
    name: "PetalAgeVerStub",
    srcs: ["PetalAgeVerStub/src/**/*.java"],
    manifest: "PetalAgeVerStub/AndroidManifest.xml",
    platform_apis: true,
    // CameraService still needs the platform-signed package, yeah.
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "PetalAgeVerStub/org.petalos.agever.xml",
    optimize: {
        enabled: false,
    },
}
