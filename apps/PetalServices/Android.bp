prebuilt_etc {
    name: "PetalGoogleGmsApks",
    srcs: ["prebuilt/gms/*.apk"],
    sub_dir: "petal/services/google/gms",
    product_specific: true,
}

prebuilt_etc {
    name: "PetalGooglePlayStoreApk",
    srcs: ["prebuilt/store/gps.apk"],
    sub_dir: "petal/services/google/store",
    product_specific: true,
}

android_app {
    name: "PetalGmsStub",
    manifest: "gms/AndroidManifest.xml",
    sdk_version: "current",
    certificate: ":petal_appcenter",
    product_specific: true,
    privileged: false,
}

android_app {
    name: "PetalPlayStoreStub",
    manifest: "store/AndroidManifest.xml",
    sdk_version: "current",
    certificate: ":petal_appcenter",
    product_specific: true,
    privileged: false,
}

prebuilt_etc {
    name: "petal-services-features.xml",
    src: "petal-services-features.xml",
    sub_dir: "sysconfig",
    product_specific: true,
}

prebuilt_etc {
    name: "petal-microg-signature-permissions.xml",
    src: "petal-microg-signature-permissions.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// real gsf is an install payload now, same deal as gms/store
prebuilt_etc {
    name: "PetalGoogleGsfApk",
    src: "prebuilt/gsf/Gsf.apk",
    filename: "gsf.apk",
    sub_dir: "petal/services/google/gsf",
    product_specific: true,
}

android_app {
    name: "PetalGsfStub",
    manifest: "gsf/AndroidManifest.xml",
    sdk_version: "current",
    certificate: ":petal_appcenter",
    product_specific: true,
    privileged: false,
}

// petal microG (rcs/wallet fork). shipped unsigned, soong signs w/ platform so it always
// matches the ROM key. NOT in PRODUCT_PACKAGES on purpose, these are payloads only
android_app_import {
    name: "PetalMicrogGms",
    apk: "prebuilt/microg/gms.apk",
    certificate: "platform",
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// companion has to share the key or LicensingService dies on microG's settings provider
android_app_import {
    name: "PetalMicrogCompanion",
    apk: "prebuilt/microg/companion.apk",
    certificate: "platform",
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "PetalMicrogApks",
    srcs: [
        ":PetalMicrogGms",
        ":PetalMicrogCompanion",
    ],
    sub_dir: "petal/services/microg",
    product_specific: true,
}
