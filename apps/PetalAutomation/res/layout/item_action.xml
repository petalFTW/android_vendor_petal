<org.petalos.automation.widget.GlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:glassCornerRadius="@dimen/petal_bubble_radius"
    app:glassBlurRadius="@dimen/petal_backdrop_blur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="@dimen/petal_icon_badge_small"
            android:layout_height="@dimen/petal_icon_badge_small"
            android:background="@drawable/petal_icon_badge">

            <ImageView
                android:id="@+id/action_icon"
                android:layout_width="@dimen/petal_icon_size_small"
                android:layout_height="@dimen/petal_icon_size_small"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_automation" />
        </FrameLayout>

        <TextView
            android:id="@+id/action_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/action_edit"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_action"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/action_remove"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_action"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</org.petalos.automation.widget.GlassCardView>
