// Single source of truth for the petalOS user-tunable customization keys.
// The values live in Settings.System and are read by SystemUI, Launcher3 and
// the petalOS Hub settings app (org.petalos.hub).
java_library_static {
    name: "petalos-config",
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    min_sdk_version: "34",
    visibility: ["//visibility:public"],
}

java_test_host {
    name: "PetalDepthNotificationPlacementTests",
    srcs: [
        "src/org/petalos/config/DepthNotificationPlacement.java",
        "tests/org/petalos/config/DepthNotificationPlacementTest.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
