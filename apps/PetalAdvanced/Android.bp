// Advanced features / hosts-based content blocker. No launcher icon, the Hub
// launches it. Not privileged, but platform signed and baked into system_ext.
android_app {
    name: "PetalAdvanced",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,

    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.core_core",
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "jsr305",
    ],
}
