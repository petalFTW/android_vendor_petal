     Aurora wash behind the glass: a flat petal base with soft coloured blobs so the
     backdrop blur on the cards actually has something to bend.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorBackground" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:centerX="0.88"
                android:centerY="0.02"
                android:startColor="@color/petal_aurora_pink"
                android:endColor="@color/petal_aurora_fade" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="640dp"
                android:centerX="0.05"
                android:centerY="0.28"
                android:startColor="@color/petal_aurora_violet"
                android:endColor="@color/petal_aurora_fade" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:centerX="0.75"
                android:centerY="0.95"
                android:startColor="@color/petal_aurora_teal"
                android:endColor="@color/petal_aurora_fade" />
        </shape>
    </item>

</layer-list>
