diff --git a/src/emu/x64syscall.c b/src/emu/x64syscall.c
index e5f29a7b..f8bba970 100644
--- a/src/emu/x64syscall.c
+++ b/src/emu/x64syscall.c
@@ -152,7 +152,8 @@ static const scwrap_t syscallwrap[] = {
     [40] = {__NR_sendfile, 4},
     [41] = {__NR_socket, 3},
     [42] = {__NR_connect, 3},
-    [43] = {__NR_accept, 3},
+    // [43] accept handled below: Android's app seccomp traps accept() but
+    // allows accept4(), so route it through accept4() with flags 0.
     [44] = {__NR_sendto, 6},
     [45] = {__NR_recvfrom, 6},
     [46] = {__NR_sendmsg, 3},
@@ -331,8 +332,9 @@ static const scwrap_t syscallwrap[] = {
     [269] = {__NR_faccessat, 3},
     [270] = {__NR_pselect6, 6},
     [272] = {__NR_unshare, 1},
-    [273] = {__NR_set_robust_list, 2},
-    [274] = {__NR_get_robust_list, 3},
+    // [273] set_robust_list and [274] get_robust_list are handled below:
+    // Android's app seccomp policy kills the process on set_robust_list, so
+    // these must never be forwarded to the host kernel.
     [280] = {__NR_utimensat, 4},
     #ifdef NOALIGN
     [281] = {__NR_epoll_pwait, 5},
@@ -1060,6 +1062,17 @@ void EXPORT x64Syscall_linux(x64emu_t *emu)
         case 334: // It is helpeful to run static binary
             R_RAX = -ENOSYS;
             break;
+        case 273:   // sys_set_robust_list (Android seccomp kills the host call)
+            R_RAX = 0;
+            break;
+        case 274:   // sys_get_robust_list
+            R_RAX = -ENOSYS;
+            break;
+        case 43:    // sys_accept -> host accept4 (Android seccomp traps accept)
+            S_RAX = syscall(__NR_accept4, S_EDI, (void*)R_RSI, (void*)R_RDX, 0);
+            if(S_RAX==-1)
+                S_RAX = -errno;
+            break;
         #ifndef __NR_faccessat2
         case 439:
             S_RAX = faccessat(S_EDI, (void*)R_RSI, (mode_t)R_RDX, S_R10d);
