+// Proton4A: glibc's time64 __futimens64 wrapper. The i386 struct __timespec64
+// is { int64 tv_sec; int32 tv_nsec; int32 :pad; } (16 bytes), not the host
+// aarch64 struct timespec ({ int64 tv_sec; int64 tv_nsec; }). Forwarding the
+// guest pointer unchanged made the host read the 4 padding bytes as the high
+// half of tv_nsec, so the kernel returned EINVAL and Wine mapped it to
+// STATUS_INVALID_PARAMETER ("Invalid parameter" in .NET/Squirrel installers).
+EXPORT int my32___futimens64(x64emu_t* emu, int fd, void* times)
+{
+    struct timespec tm[2];
+    if (times) {
+        uint8_t* t = (uint8_t*)times;
+        tm[0].tv_sec  = *(int64_t*)(t + 0);
+        tm[0].tv_nsec = *(int32_t*)(t + 8);
+        tm[1].tv_sec  = *(int64_t*)(t + 16);
+        tm[1].tv_nsec = *(int32_t*)(t + 24);
+    }
+    int ret = futimens(fd, times ? tm : NULL);
+    static int box64_log_time = -1;
+    if (box64_log_time < 0) box64_log_time = getenv("BOX64_LOG_TIME") != NULL;
+    if (box64_log_time) {
+        printf_log(LOG_INFO, "my32___futimens64(%d, %p) = %d errno=%d sec=%lld nsec=%lld sec1=%lld nsec1=%lld\n",
+                fd, times, ret, (ret<0) ? errno : 0,
+                times ? (long long)tm[0].tv_sec : 0, times ? (long long)tm[0].tv_nsec : 0,
+                times ? (long long)tm[1].tv_sec : 0, times ? (long long)tm[1].tv_nsec : 0);
+    }
+    return ret;
+}
