<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.petalos.settings.prism">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Platform-signed ROM front end: read the home wallpaper for the blurred backdrop. -->
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />

    <queries>
        <package android:name="org.petalos.hub" />
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_petal"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetalSettings">

        <activity
            android:name=".PrismSettingsActivity"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
