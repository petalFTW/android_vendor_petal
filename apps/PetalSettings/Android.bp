// Settings front end. AOSP Settings retains the stable Android entry points and
// forwards its ordinary homepage launches here; its detailed pages stay installed.
android_app {
    name: "PetalSettings",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    sdk_version: "36",
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "petal-settings-privapp.xml",
    product_specific: true,
    min_sdk_version: "34",

    optimize: {
        enabled: false,
    },

    static_libs: [
        "petalos-config",
    ],
}
