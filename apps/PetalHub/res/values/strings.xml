    <string name="power_summary">Control reversible screen-off restrictions</string>
    <string name="power_policy_enabled_title">Idle optimization</string>
    <string name="power_policy_enabled_summary">Puts background apps to sleep once the screen has been off for a while. Glancing at the screen doesn\'t undo it, unlocking does.</string>
    <string name="power_status_title">Right now</string>
    <string name="power_status_off">Off</string>
    <string name="power_status_empty">Nothing to restrict yet. Turn on automatic picking or add apps below.</string>
    <string name="power_status_ready">Ready. Starts %1$s after the screen goes off.</string>
    <string name="power_status_waiting">Screen is off. Starts %1$s after it went off.</string>
    <string name="power_status_active">Active since %1$s · %2$d apps asleep</string>
    <string name="power_status_unknown">No report from the idle service yet. It shows up after the first screen-off.</string>
    <string name="power_grace_now">straight away</string>
    <string name="power_grace_minutes">%1$d min</string>
    <string name="power_auto_title">Pick apps automatically</string>
    <string name="power_auto_summary">Includes apps you haven\'t opened in about a day. Your SMS, phone, launcher, keyboard, alarm, music, VPN and accessibility apps are always left alone.</string>
    <string name="power_profile_title">How hard</string>
    <string name="power_profile_optimized_summary">Gentle: apps get fewer background jobs and syncs. They keep network, so messages still arrive.</string>
    <string name="power_profile_deep_summary">Strict: apps also lose network, wakelocks, location and Bluetooth scanning until you unlock. The phone also sleeps deeply even while moving, and the CPU is capped while the screen is off. Notifications from these apps can arrive late.</string>
    <string name="power_grace_title">Wait after screen off</string>
    <string name="power_packages_title">Always include these apps</string>
    <string name="power_packages_none">None. Add apps that drain battery even though you use them.</string>
    <plurals name="power_packages_count">
        <item quantity="one">%1$d app always included</item>
        <item quantity="other">%1$d apps always included</item>
    </plurals>
