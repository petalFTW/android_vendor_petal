<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="qs_skin_enabled"
        android:title="@string/qs_skin_enabled_title"
        android:summary="@string/qs_skin_enabled_summary" />

    <SeekBarPreference
        android:key="qs_emission"
        android:title="@string/qs_emission_title"
        android:summary="@string/qs_emission_summary"
        app:dependency="qs_skin_enabled" />

    <SeekBarPreference
        android:key="qs_blur_intensity"
        android:persistent="false"
        android:title="@string/qs_blur_title" />

</PreferenceScreen>
