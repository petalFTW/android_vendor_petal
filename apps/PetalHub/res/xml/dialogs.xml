<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <ListPreference
        android:key="petal_ui_dialog_style"
        android:title="@string/dialog_style_title"
        android:persistent="false"
        android:entries="@array/dialog_style_entries"
        android:entryValues="@array/dialog_style_values" />
    <org.petalos.hub.BezelPlacementPreference
        android:key="volume_placement"
        android:title="@string/volume_anchor_title"
        android:summary="@string/bezel_placement_hint" />
    <org.petalos.hub.BezelPlacementPreference
        android:key="power_placement"
        android:title="@string/power_anchor_title"
        android:summary="@string/bezel_placement_hint" />
    <org.petalos.hub.BezelPlacementPreference
        android:key="extra_key_placement"
        android:title="@string/extra_key_anchor_title"
        android:summary="@string/extra_key_placement_hint" />
