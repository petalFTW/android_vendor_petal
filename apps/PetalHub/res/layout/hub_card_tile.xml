<org.petalos.hub.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/petal_tile_height"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:glassCornerRadius="@dimen/petal_tile_radius"
    app:glassBlurRadius="@dimen/petal_backdrop_blur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/hub_tile_badge"
            android:layout_width="@dimen/petal_icon_badge"
            android:layout_height="@dimen/petal_icon_badge"
            android:background="@drawable/petal_icon_badge">

            <ImageView
                android:id="@+id/hub_tile_icon"
                android:layout_width="@dimen/petal_icon_size"
                android:layout_height="@dimen/petal_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/hub_tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hub_tile_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</org.petalos.hub.GlassCardView>
