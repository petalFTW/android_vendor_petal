# Fragments are instantiated reflectively by HubActivity (via
# Fragment.instantiate / the :settings:show_fragment extra) and via the
# app:fragment attribute in preference XML.
-keep class org.petalos.hub.*Fragment

# Preferences inflated from preference XML resources (e.g. ColorPickerPreference)
# are instantiated reflectively, so keep their constructors.
-keep public class * extends androidx.preference.* {
    public <init>(android.content.Context, android.util.AttributeSet);
}

# Manifest-declared boot receiver.
-keep class org.petalos.hub.FontDefaultReceiver { *; }

# Android instantiates this content provider from the manifest for APK install URIs.
-keep class org.petalos.hub.Proton4AApkProvider { *; }
