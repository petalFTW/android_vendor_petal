// petalOS flagship camera.
//
// Built on CameraX (the same vendored AARs Aperture uses) so it rides whatever
// camera HAL the device ships. Vendor bits (OPlus CameraUnit SDK, QTI/oplus
// vendor tags, CameraX vendor extensions) are reached reflectively at runtime
// so the same APK works on every petal device / blob set.
android_app {
    name: "PetalCam",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",

    sdk_version: "36",
    min_sdk_version: "34",

    product_specific: true,
    privileged: true,
    privapp_allowlist: "org.petalos.cam.xml",
    certificate: "platform",

    // petalOS ships PetalCam instead of the LineageOS camera.
    overrides: ["Aperture", "Camera2"],

    use_embedded_native_libs: true,

    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },

    static_libs: [
        "androidx.activity_activity",
        "androidx.appcompat_appcompat",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core",
        "androidx.exifinterface_exifinterface",
        "androidx.fragment_fragment",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
        "guava",
        "kotlin-stdlib",
        // Pure-Java ZXing core (external/zxing) for on-device QR/barcode decode.
        "zxing-core",
        // TF Lite for the denoiser; SplitterNet falls back to XNNPACK cpu since
        // its slice/pad ops dont sit on the gpu delegate
        "petal-tflite",
        "petal-tflite-api",
        "petal-tflite-gpu",
        "petal-tflite-gpu-api",
        // ONNX Runtime for the monocular depth / portrait bokeh model.
        // Module is defined in vendor/petal/apps/PetalDepth/Android.bp.
        "petal-depth-onnxruntime",
        // CameraX, vendored under packages/apps/Aperture/app/libs so petalOS
        // stays on the exact same camera stack Aperture is validated against.
        "Aperture_androidx.camera_camera-camera2",
        "Aperture_androidx.camera_camera-core",
        "Aperture_androidx.camera_camera-extensions",
        "Aperture_androidx.camera_camera-lifecycle",
        "Aperture_androidx.camera_camera-video",
        "Aperture_androidx.camera_camera-view",
    ],

    // Lets CameraX auto-load the OEM extension implementation
    // (/system_ext/framework/androidx.camera.extensions.impl.jar on OPlus).
    optional_uses_libs: [
        "androidx.camera.extensions.impl",
    ],
}

android_library_import {
    name: "petal-tflite",
    aars: ["libs/litert-1.4.2.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
    extract_jni: true,
}

android_library_import {
    name: "petal-tflite-gpu",
    aars: ["libs/litert-gpu-1.4.2.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
    extract_jni: true,
}

android_library_import {
    name: "petal-tflite-api",
    aars: ["libs/litert-api-1.4.2.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}

android_library_import {
    name: "petal-tflite-gpu-api",
    aars: ["libs/litert-gpu-api-1.4.2.aar"],
    sdk_version: "current",
    min_sdk_version: "24",
}
