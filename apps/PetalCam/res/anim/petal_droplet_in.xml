     petal droplet-in: the island's emerge curve, scale from a slightly
     sunk capsule with a soft alpha ramp.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="0.92" android:toXScale="1.0"
        android:fromYScale="0.92" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="380" />
    <alpha
        android:fromAlpha="0.0" android:toAlpha="1.0"
        android:duration="240" />
</set>
