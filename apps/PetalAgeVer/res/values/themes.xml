<resources>
    <style name="Theme.PetalAgeVer" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/agever_void</item>
        <item name="android:colorBackground">@color/agever_void</item>
        <item name="android:fontFamily">@font/petal_rubik</item>
        <item name="fontFamily">@font/petal_rubik</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/agever_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/agever_light_bars</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColorPrimary">@color/agever_text_primary</item>
        <item name="android:textColorSecondary">@color/agever_text_secondary</item>
        <item name="colorAccent">@color/agever_accent</item>
        <item name="colorControlActivated">@color/agever_accent</item>
        <item name="colorControlHighlight">@color/agever_ripple</item>
    </style>
    <style name="AgeVer.SectionTitle" parent="">
        <item name="android:textColor">@color/agever_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="AgeVer.RowTitle" parent="">
        <item name="android:textColor">@color/agever_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/petal_rubik</item>
    </style>
    <style name="AgeVer.RowSummary" parent="">
        <item name="android:textColor">@color/agever_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="AgeVer.Body" parent="">
        <item name="android:textColor">@color/agever_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="AgeVer.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="AgeVer.Button" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:fontFamily">@font/petal_rubik</item>
        <item name="android:textColor">@color/agever_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="AgeVer.Mode" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_mode</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/petal_rubik</item>
        <item name="android:textColor">@color/agever_text_primary</item>
    </style>
</resources>
