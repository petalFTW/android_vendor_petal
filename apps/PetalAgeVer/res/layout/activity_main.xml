<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agever_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/agever_void" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="8dp" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageButton android:id="@+id/button_back" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="-12dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp" android:contentDescription="@string/action_back" android:src="@drawable/ic_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="4dp" android:fontFamily="@font/petal_ui" android:textFontWeight="600"
                android:textSize="30sp" android:accessibilityHeading="true" android:maxLines="2"
                android:text="@string/title_agever" android:textColor="@color/agever_text_primary" />
        </LinearLayout>
        <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/main_subtitle" />

        <!-- the stage goes first, it's the whole point of the app -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/agever_preview_height"
            android:layout_marginTop="20dp" android:background="@drawable/bg_preview" android:clipToOutline="true">
            <SurfaceView android:id="@+id/preview_surface" android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="@string/desc_preview" />
            <TextView android:id="@+id/preview_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="12dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="14sp" android:textFontWeight="500"
                android:background="@drawable/bg_preview_status" android:accessibilityLiveRegion="polite"
                android:text="@string/state_off" android:textColor="@color/agever_preview_text" />
        </FrameLayout>
        <TextView android:id="@+id/status_detail" style="@style/AgeVer.Body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite" android:text="@string/detail_off" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button android:id="@+id/button_preview" style="@style/AgeVer.Button.Secondary" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/button_preview" />
            <Button android:id="@+id/button_toggle" style="@style/AgeVer.Button" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="@string/button_start" />
        </LinearLayout>
        <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/session_scope" />

        <TextView style="@style/AgeVer.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/library_title" />
        <LinearLayout style="@style/AgeVer.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <Spinner android:id="@+id/avatar_spinner" style="@style/AgeVer.Field" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:contentDescription="@string/label_avatar" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/button_import" style="@style/AgeVer.Button.Secondary" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/button_pick_avatar" />
                <Button android:id="@+id/button_library" style="@style/AgeVer.Button.Secondary" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                    android:text="@string/library_manage" />
            </LinearLayout>
            <TextView android:id="@+id/library_storage" style="@style/AgeVer.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/import_help" />
            <ProgressBar android:id="@+id/import_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
                android:indeterminateTint="@color/agever_accent" android:contentDescription="@string/importing_avatar"
                android:visibility="gone" />
            <Button android:id="@+id/button_cancel_import" style="@style/AgeVer.Button.Secondary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cancel_import"
                android:visibility="gone" />
        </LinearLayout>

        <TextView style="@style/AgeVer.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/section_control" />
        <LinearLayout style="@style/AgeVer.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioGroup android:id="@+id/mode_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_seg" android:orientation="horizontal" android:padding="4dp"
                android:contentDescription="@string/label_mode">
                <RadioButton android:id="@+id/mode_joystick" style="@style/AgeVer.Mode" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mode_joystick" />
                <RadioButton android:id="@+id/mode_idle" style="@style/AgeVer.Mode" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp"
                    android:text="@string/mode_idle" />
            </RadioGroup>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_mirror" style="@style/AgeVer.SwitchRow"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/label_mirror" />
            <View style="@style/AgeVer.Divider" android:layout_width="match_parent" android:layout_height="1dp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_idle" style="@style/AgeVer.SwitchRow"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_idle_motion" />
            <View style="@style/AgeVer.Divider" android:layout_width="match_parent" android:layout_height="1dp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_joystick" style="@style/AgeVer.SwitchRow"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_joystick" />
            <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/summary_joystick" />
        </LinearLayout>

        <TextView style="@style/AgeVer.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/advanced_title" />
        <LinearLayout style="@style/AgeVer.Card" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView style="@style/AgeVer.RowTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:labelFor="@id/fps_spinner" android:text="@string/frame_rate" />
            <Spinner android:id="@+id/fps_spinner" style="@style/AgeVer.Field" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:contentDescription="@string/frame_rate" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_restore" style="@style/AgeVer.SwitchRow"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/restore_on_boot" />
            <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/restore_on_boot_summary" />
            <TextView style="@style/AgeVer.Body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:autoLink="web" android:text="@string/avatar_credits" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
