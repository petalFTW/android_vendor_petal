<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/joystick_root" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:background="@drawable/bg_pill" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/panel_drag" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/panel_title"
        android:textColor="@color/agever_text_primary" android:textSize="14sp"
        android:contentDescription="@string/panel_drag" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/panel_toggle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_weight="1" android:text="@string/panel_collapse" />
        <Button android:id="@+id/panel_stop" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_weight="1" android:text="@string/notification_stop" />
    </LinearLayout>
    <ScrollView android:id="@+id/controls_body" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="horizontal">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center_horizontal" android:orientation="vertical">
                    <org.petalos.agever.ui.JoystickView android:id="@+id/joystick_move"
                        android:layout_width="@dimen/agever_joystick_size" android:layout_height="@dimen/agever_joystick_size"
                        android:contentDescription="@string/desc_joystick_move" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/joystick_move" android:textColor="@color/agever_text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <org.petalos.agever.ui.JoystickView android:id="@+id/joystick_turn"
                        android:layout_width="@dimen/agever_joystick_size" android:layout_height="@dimen/agever_joystick_size"
                        android:contentDescription="@string/desc_joystick_turn" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/joystick_turn" android:textColor="@color/agever_text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <org.petalos.agever.ui.JoystickView android:id="@+id/joystick_distance"
                        android:layout_width="@dimen/agever_joystick_size" android:layout_height="@dimen/agever_joystick_size"
                        android:contentDescription="@string/desc_joystick_distance" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/joystick_distance" android:textColor="@color/agever_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/expression_controls" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:columnCount="2">
                    <TextView android:id="@+id/expression_smile" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_smile" android:contentDescription="@string/desc_smile" />
                    <TextView android:id="@+id/expression_frown" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_frown" android:contentDescription="@string/desc_frown" />
                    <TextView android:id="@+id/expression_open" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_open" android:contentDescription="@string/desc_mouth" />
                    <TextView android:id="@+id/expression_brow_up" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_brow_up" android:contentDescription="@string/desc_brows_up" />
                    <TextView android:id="@+id/expression_brow_down" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_brow_down" android:contentDescription="@string/desc_brows_down" />
                    <TextView android:id="@+id/expression_surprise" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_surprise" android:contentDescription="@string/desc_surprise" />
                    <TextView android:id="@+id/expression_neutral" style="@style/AgeVer.Expression"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1"
                        android:text="@string/expression_neutral" android:contentDescription="@string/desc_neutral" />
                </GridLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="@string/expression_speed" android:textColor="@color/agever_text_secondary" android:textSize="13sp" />
                <SeekBar android:id="@+id/expression_speed" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:max="100" android:contentDescription="@string/desc_expression_speed" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/speed_slow" android:textColor="@color/agever_text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/speed_fast" android:textColor="@color/agever_text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/expression_unavailable" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/expressions_unavailable"
                android:textColor="@color/agever_text_secondary" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
