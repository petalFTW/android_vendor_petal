<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tuner_title"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tuner_accent_teal"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_profile"
            style="@style/TunerOverlayChip"
            android:text="@string/overlay_action_profile" />

        <TextView
            android:id="@+id/overlay_bypass"
            style="@style/TunerOverlayChip"
            android:layout_marginStart="6dp"
            android:text="@string/overlay_action_bypass" />

        <TextView
            android:id="@+id/overlay_boost"
            style="@style/TunerOverlayChip"
            android:layout_marginStart="6dp"
            android:text="@string/overlay_action_boost" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_kill"
            style="@style/TunerOverlayChip"
            android:text="@string/overlay_action_kill" />

        <TextView
            android:id="@+id/overlay_recents"
            style="@style/TunerOverlayChip"
            android:layout_marginStart="6dp"
            android:text="@string/overlay_action_recents" />

        <TextView
            android:id="@+id/overlay_close"
            style="@style/TunerOverlayChip"
            android:layout_marginStart="6dp"
            android:text="@string/overlay_action_close" />
    </LinearLayout>
</LinearLayout>
