// Stateful petalOS idle policy. Preserves and restores per-app state and never
// changes the device-wide location mode.
android_app {
    name: "PetalPower",

    srcs: ["src/**/*.java"],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "org.petalos.power.xml",
}
