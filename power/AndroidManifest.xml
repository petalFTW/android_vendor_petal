<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.petalos.power"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_APP_IDLE_STATE" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <application
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="petalOS Idle Power">

        <receiver
            android:name=".IdlePowerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- Per-app network access toggle, enforced with the netd firewall. -->
        <receiver android:name=".SpoofPolicyReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="org.petalos.power.action.SPOOF_POLICY_CHANGED" />
                <action android:name="org.petalos.power.action.UPDATE_IDLE_POLICY" />
            </intent-filter>
        </receiver>

        <!-- Per-app network access toggle, enforced with the netd firewall. -->
        <receiver
            android:name=".NetworkPolicyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="org.petalos.power.action.APPLY_NETWORK_POLICY" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
